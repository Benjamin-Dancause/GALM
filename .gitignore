# ============================================
# 1. Build artifacts
# ============================================

# CMake build directories (CLion uses cmake-build-debug / cmake-build-release by default)
cmake-build-*/
build*/
_build*/
out/

# Compiled object files and executables
*.o
*.obj
*.exe
*.out
*.app

# Libraries
*.so
*.dylib
*.dll
*.a
*.lib
*.la
*.lai

# Precompiled headers
*.gch
*.pch

# Debugging and linker files
*.pdb
*.ilk
*.iobj
*.ipdb

# ============================================
# 2. Qt-generated files
# ============================================

# Files generated by moc (Meta-Object Compiler), uic (UI Compiler), rcc (Resource Compiler)
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.moc

# Qt cache and temporary files
.qmake.stash
.qmake.cache
**/.rcc/
**/.qt/
**/qmlcache/
*.qmlc
*.jsc

# ============================================
# 3. CLion / JetBrains IDE configuration
# ============================================

# The .idea directory contains project-specific settings
.idea/

# User-specific IDE files (these contain local paths and settings)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf/
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml

# Module files (usually not needed when using CMake)
*.iml
*.ipr
*.iws

# ============================================
# 4. Other editors (Qt Creator)
# ============================================

# Qt Creator user files
*.pro.user*
CMakeLists.txt.user*
*.autosave

# ============================================
# 5. OS-specific files
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================
# 6. Compilation database and tool caches
# ============================================

compile_commands.json
.clangd/
.cache/
